# Example Caddy configuration for serving the Floating Cities apps over HTTPS
#
# Prerequisites:
#   - Install Caddy (https://caddyserver.com/docs/install) on the Windows host
#   - Make sure ports 80 and 443 are open and forwarded to this machine
#   - Build the viewer once (npm run build) so that the dist/ folder exists
#   - The Flask gateway must keep running on http://127.0.0.1:5050
#
# Save this file as "Caddyfile" (without extension) alongside caddy.exe or supply
# the full path with `caddy run --config C:\path\to\Caddyfile`.
# Replace the placeholders in ALL_CAPS with real values for your environment.

sciencecentreontour.tudelft.nl {
    # Serve the pre-built viewer (npm run build)
    root * C:\Rec\UniStuff\SCD\floating_cities\DrijvendeSteden\city-viewer\dist
    encode gzip zstd

    # Route API and gateway assets to the Flask service
    @backend path /api/* /link/* /static/* /upload/*
    handle @backend {
        reverse_proxy 127.0.0.1:5050
    }

    # Serve the viewer SPA and fall back to index.html for history API routing
    handle {
        file_server
        try_files {path} /index.html
    }

    # Optional security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
    }

    # Access/error logs (optional)
    log {
        output file C:\Rec\Logs\caddy\access.log
    }
}

# Serve the recognition UI on :5050 with TLS and forward to Flask.
# Browsers must use https://…:5050 directly; plain HTTP on that port
# cannot be multiplexed with HTTPS and will fail by design.
https://sciencecentreontour.tudelft.nl:5050 {
    reverse_proxy 127.0.0.1:5050

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
    }

    log {
        output file C:\Rec\Logs\caddy\recognition-access.log
    }
}
